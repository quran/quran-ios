<plist version="1.0">
<dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>bookmarks.collections.ayahs.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d marcador</string>
            <key>other</key>
            <string>%d marcadores</string>
        </dict>
    </dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>bookmarks.editor.title</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@ayahs@</string>
        <key>ayahs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Guardar ayah...</string>
            <key>other</key>
            <string>Guardar ayahs...</string>
        </dict>
    </dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>notes.editor.words-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@words@</string>
        <key>words</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d palavra</string>
            <key>other</key>
            <string>%d palavras</string>
        </dict>
    </dict>
    <!-- Additional reading bookmarks hidden by the collapsed section. -->
    <key>bookmarks.reading.more-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Mais %d marcador</string>
            <key>other</key>
            <string>Mais %d marcadores</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item não está sincronizando</string>
            <key>other</key>
            <string>%d itens não estão sincronizando</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@verses@</string>
        <key>verses</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d ayah aguardando</string>
            <key>other</key>
            <string>%d ayahs aguardando</string>
        </dict>
    </dict>
    <!-- How many items don't sync until the item above them does. -->
    <key>sync.held.waiting.items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item aguardando</string>
            <key>other</key>
            <string>%d itens aguardando</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d tentativa</string>
            <key>other</key>
            <string>%d tentativas</string>
        </dict>
    </dict>
    <!-- Sign-out warning: how many changes the next sync would send, which signing out loses. -->
    <key>sync.sign-out.pending</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d alteração ainda está aguardando sincronização com o Quran.com.</string>
            <key>other</key>
            <string>%d alterações ainda estão aguardando sincronização com o Quran.com.</string>
        </dict>
    </dict>
    <!-- Sign-out warning: how many items don't sync until the user fixes them, which signing out loses. -->
    <key>sync.sign-out.held</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item não pode ser sincronizado até você corrigi-lo.</string>
            <key>other</key>
            <string>%d itens não podem ser sincronizados até você corrigi-los.</string>
        </dict>
    </dict>
</dict>
</plist>
