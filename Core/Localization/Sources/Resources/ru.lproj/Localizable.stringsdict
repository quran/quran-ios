            <key>one</key>
            <string>Ещё %d закладка</string>
            <key>few</key>
            <string>Ещё %d закладки</string>
            <key>many</key>
            <string>Ещё %d закладок</string>
            <key>other</key>
            <string>Ещё %d закладки</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d элемент не синхронизируется</string>
            <key>few</key>
            <string>%d элемента не синхронизируются</string>
            <key>many</key>
            <string>%d элементов не синхронизируются</string>
            <key>other</key>
            <string>%d элемента не синхронизируются</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
