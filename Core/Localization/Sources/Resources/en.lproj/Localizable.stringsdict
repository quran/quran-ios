<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>bookmarks.collections.ayahs.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d bookmark</string>
            <key>other</key>
            <string>%d bookmarks</string>
        </dict>
    </dict>
    <key>bookmarks.editor.title</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@ayahs@</string>
        <key>ayahs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Save Ayah...</string>
            <key>other</key>
            <string>Save Ayahs...</string>
        </dict>
    </dict>
    <key>notes.editor.words-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@words@</string>
        <key>words</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d word</string>
            <key>other</key>
            <string>%d words</string>
        </dict>
    </dict>
    <!-- Additional reading bookmarks hidden by the collapsed section. -->
    <key>bookmarks.reading.more-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d more bookmark</string>
            <key>other</key>
            <string>%d more bookmarks</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item isn't syncing</string>
            <key>other</key>
            <string>%d items aren't syncing</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@verses@</string>
        <key>verses</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d verse is waiting on it</string>
            <key>other</key>
            <string>%d verses are waiting on it</string>
        </dict>
    </dict>
    <!-- How many items don't sync until the item above them does. -->
    <key>sync.held.waiting.items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item is waiting on it</string>
            <key>other</key>
            <string>%d items are waiting on it</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d attempt</string>
            <key>other</key>
            <string>%d attempts</string>
        </dict>
    </dict>
    <!-- Sign-out confirmation: how many items haven't synced and would be lost. -->
    <key>sync.sign-out.unsynced</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d item hasn't synced to Quran.com yet and will be lost if you sign out.</string>
            <key>other</key>
            <string>%d items haven't synced to Quran.com yet and will be lost if you sign out.</string>
        </dict>
    </dict>
</dict>
</plist>
