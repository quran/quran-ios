            <key>other</key>
            <string>%d элемента ожидают</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
