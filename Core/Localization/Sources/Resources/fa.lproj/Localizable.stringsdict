            <key>one</key>
            <string>%d نشانک دیگر</string>
            <key>other</key>
            <string>%d نشانک دیگر</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d مورد همگام‌سازی نمی‌شود</string>
            <key>other</key>
            <string>%d مورد همگام‌سازی نمی‌شوند</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@verses@</string>
        <key>verses</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d آیه در انتظار</string>
            <key>other</key>
            <string>%d آیه در انتظار</string>
        </dict>
    </dict>
    <!-- How many items don't sync until the item above them does. -->
    <key>sync.held.waiting.items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d مورد در انتظار</string>
            <key>other</key>
            <string>%d مورد در انتظار</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d تلاش</string>
            <key>other</key>
            <string>%d تلاش</string>
        </dict>
    </dict>
    <!-- Sign-out warning: how many changes the next sync would send, which signing out loses. -->
    <key>sync.sign-out.pending</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d تغییر هنوز در انتظار همگام‌سازی با Quran.com است.</string>
            <key>other</key>
            <string>%d تغییر هنوز در انتظار همگام‌سازی با Quran.com است.</string>
        </dict>
    </dict>
    <!-- Sign-out warning: how many items don't sync until the user fixes them, which signing out loses. -->
    <key>sync.sign-out.held</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d مورد تا وقتی اصلاحش نکنید همگام‌سازی نمی‌شود.</string>
            <key>other</key>
            <string>%d مورد تا وقتی اصلاحشان نکنید همگام‌سازی نمی‌شوند.</string>
        </dict>
    </dict>
    <!-- Sign-out warning: how many items don't sync until the user fixes them (held), and how many more wait on those. -->
    <key>sync.sign-out.held-waiting</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@held@ و %2$#@waiting@</string>
        <key>held</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%1$d مورد تا وقتی اصلاحش نکنید همگام‌سازی نمی‌شود</string>
            <key>other</key>
            <string>%1$d مورد تا وقتی اصلاحشان نکنید همگام‌سازی نمی‌شوند</string>
        </dict>
        <key>waiting</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%2$d مورد دیگر هم تا آن وقت همگام‌سازی نمی‌شود.</string>
            <key>other</key>
            <string>%2$d مورد دیگر هم تا آن وقت همگام‌سازی نمی‌شوند.</string>
        </dict>
    </dict>
</dict>
</plist>
