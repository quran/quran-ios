<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>bookmarks.collections.ayahs.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد إشارات مرجعية</string>
            <key>one</key>
            <string>إشارة مرجعية واحدة</string>
            <key>two</key>
            <string>إشارتان مرجعيتان</string>
            <key>few</key>
            <string>%d إشارات مرجعية</string>
            <key>many</key>
            <string>%d إشارة مرجعية</string>
            <key>other</key>
            <string>%d إشارة مرجعية</string>
        </dict>
    </dict>
    <key>bookmarks.editor.title</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@ayahs@</string>
        <key>ayahs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>حفظ الآيات...</string>
            <key>one</key>
            <string>حفظ آية...</string>
            <key>two</key>
            <string>حفظ آيتين...</string>
            <key>few</key>
            <string>حفظ الآيات...</string>
            <key>many</key>
            <string>حفظ الآيات...</string>
            <key>other</key>
            <string>حفظ الآيات...</string>
        </dict>
    </dict>
    <key>notes.editor.words-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@words@</string>
        <key>words</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد كلمات</string>
            <key>one</key>
            <string>كلمة واحدة</string>
            <key>two</key>
            <string>كلمتان</string>
            <key>few</key>
            <string>%d كلمات</string>
            <key>many</key>
            <string>%d كلمة</string>
            <key>other</key>
            <string>%d كلمة</string>
        </dict>
    </dict>
    <!-- Additional reading bookmarks hidden by the collapsed section. -->
    <key>bookmarks.reading.more-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد علامات إضافية</string>
            <key>one</key>
            <string>علامة إضافية واحدة</string>
            <key>two</key>
            <string>علامتان إضافيتان</string>
            <key>few</key>
            <string>%d علامات إضافية</string>
            <key>many</key>
            <string>%d علامة إضافية</string>
            <key>other</key>
            <string>%d علامة إضافية</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا توجد عناصر لا تتم مزامنتها</string>
            <key>one</key>
            <string>عنصر واحد لا تتم مزامنته</string>
            <key>two</key>
            <string>عنصران لا تتم مزامنتهما</string>
            <key>few</key>
            <string>%d عناصر لا تتم مزامنتها</string>
            <key>many</key>
            <string>%d عنصرًا لا تتم مزامنته</string>
            <key>other</key>
            <string>%d عنصر لا تتم مزامنته</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@verses@</string>
        <key>verses</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا آيات في الانتظار</string>
            <key>one</key>
            <string>آية واحدة في الانتظار</string>
            <key>two</key>
            <string>آيتان في الانتظار</string>
            <key>few</key>
            <string>%d آيات في الانتظار</string>
            <key>many</key>
            <string>%d آية في الانتظار</string>
            <key>other</key>
            <string>%d آية في الانتظار</string>
        </dict>
    </dict>
    <!-- How many items don't sync until the item above them does. -->
    <key>sync.held.waiting.items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>لا عناصر في الانتظار</string>
            <key>one</key>
            <string>عنصر واحد في الانتظار</string>
            <key>two</key>
            <string>عنصران في الانتظار</string>
            <key>few</key>
            <string>%d عناصر في الانتظار</string>
            <key>many</key>
            <string>%d عنصرًا في الانتظار</string>
            <key>other</key>
            <string>%d عنصر في الانتظار</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d محاولة</string>
            <key>one</key>
            <string>محاولة واحدة</string>
            <key>two</key>
            <string>محاولتان</string>
            <key>few</key>
            <string>%d محاولات</string>
            <key>many</key>
            <string>%d محاولة</string>
            <key>other</key>
            <string>%d محاولة</string>
        </dict>
    </dict>
</dict>
</plist>
