<plist version="1.0">
<dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>bookmarks.collections.ayahs.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d signet</string>
            <key>other</key>
            <string>%d signets</string>
        </dict>
    </dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>bookmarks.editor.title</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@ayahs@</string>
        <key>ayahs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>Enregistrer l’ayah...</string>
            <key>other</key>
            <string>Enregistrer les ayahs...</string>
        </dict>
    </dict>
    <!-- Metadata: Translated by ChatGPT; human review required. -->
    <key>notes.editor.words-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@words@</string>
        <key>words</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d mot</string>
            <key>other</key>
            <string>%d mots</string>
        </dict>
    </dict>
    <!-- Additional reading bookmarks hidden by the collapsed section. -->
    <key>bookmarks.reading.more-count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@bookmarks@</string>
        <key>bookmarks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d marque-page supplémentaire</string>
            <key>other</key>
            <string>%d marque-pages supplémentaires</string>
        </dict>
    </dict>
    <!-- How many items don't sync. -->
    <key>sync.held.count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d élément n’est pas synchronisé</string>
            <key>other</key>
            <string>%d éléments ne sont pas synchronisés</string>
        </dict>
    </dict>
    <!-- How many bookmarked verses don't sync until the item above them does. -->
    <key>sync.held.waiting.verses</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@verses@</string>
        <key>verses</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d ayah en attente</string>
            <key>other</key>
            <string>%d ayahs en attente</string>
        </dict>
    </dict>
    <!-- How many items don't sync until the item above them does. -->
    <key>sync.held.waiting.items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d élément en attente</string>
            <key>other</key>
            <string>%d éléments en attente</string>
        </dict>
    </dict>
    <!-- How many times a failed sync tried, counting retries. -->
    <key>sync.run.attempts</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@attempts@</string>
        <key>attempts</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d tentative</string>
            <key>other</key>
            <string>%d tentatives</string>
        </dict>
    </dict>
    <!-- Sign-out confirmation: how many items haven't synced and would be lost. -->
    <key>sync.sign-out.unsynced</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d élément n’est pas encore synchronisé avec Quran.com et sera perdu si vous vous déconnectez.</string>
            <key>other</key>
            <string>%d éléments ne sont pas encore synchronisés avec Quran.com et seront perdus si vous vous déconnectez.</string>
        </dict>
    </dict>
</dict>
</plist>
